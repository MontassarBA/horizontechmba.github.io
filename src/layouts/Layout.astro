---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import AiAdvisor from '../components/AiAdvisor.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
}

const { 
  title, 
  description,
  keywords = 'embedded systems consulting, electronics design, PCB design, firmware development, medical devices IEC 60601 IEC 62304, smart metering DLMS COSEM, functional safety IEC 61508 ISO 13849 ISO 26262, EMI EMC, HIL SIL, industrial automation, off-highway equipment, Lévis Quebec Canada, consultant systèmes embarqués, conception électronique, dispositifs médicaux, comptage intelligent',
  ogImage = '/og-image.png',
  ogType = 'website',
  canonicalPath
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const companyLegalName = lang === 'fr' ? 'HORIZONTECH MBA inc.' : 'HORIZONTECH MBA Inc.';
const defaultDescription = lang === 'fr'
  ? `${companyLegalName} - Consultation en systèmes embarqués et conception électronique pour dispositifs médicaux, comptage intelligent et équipements hors-route. IEC 60601/62304, IEC 61508, ISO 13849, DLMS/COSEM. Lévis, Québec.`
  : `${companyLegalName} - Embedded systems consulting and electronics design for medical devices, smart metering, and off-highway equipment. IEC 60601/62304, IEC 61508, ISO 13849, DLMS/COSEM. Lévis, Québec, Canada.`;
const finalDescription = description ?? defaultDescription;
const currentPath = Astro.url.pathname;
const baseUrl = 'https://www.horizontechmba.com';
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || '';
const jsonStringify = JSON['stringify'];

// Determine canonical URL
const canonical = canonicalPath ? `${baseUrl}${canonicalPath}` : `${baseUrl}${currentPath}`;

// Determine alternate language URLs
const pathWithoutLang = currentPath.replace(/^\/(en|fr)/, '');
const enUrl = `${baseUrl}/en${pathWithoutLang}`;
const frUrl = `${baseUrl}/fr${pathWithoutLang}`;

// Full title for meta tags
const fullTitle = `${title} | ${companyLegalName}`;

// Schema.org structured data
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": companyLegalName,
  "alternateName": "HORIZONTECH MBA",
  "url": baseUrl,
  "logo": `${baseUrl}/logo.png`,
  "image": `${baseUrl}/og-image.png`,
  "description": lang === 'fr' 
    ? "Cabinet de consultation en ingénierie spécialisé en systèmes embarqués, conception électronique et conformité pour les dispositifs médicaux, le comptage intelligent d'énergie et les équipements hors-route."
    : "Engineering consulting firm specialized in embedded systems, electronics design, and compliance for medical devices, smart energy metering, and off-highway equipment.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "7139 Rue Henri-Julien",
    "addressLocality": "Lévis",
    "addressRegion": "QC",
    "postalCode": "G6Y 9X5",
    "addressCountry": "CA"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "46.7387",
    "longitude": "-71.2480"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "contact@horizontechmba.com",
    "contactType": "customer service",
    "availableLanguage": ["English", "French"]
  },
  "sameAs": [
    "https://www.linkedin.com/company/horizontechmba"
  ],
  "areaServed": ["CA", "US", "FR"],
  "serviceType": [
    "Embedded Systems Consulting",
    "Electronics & PCB Design",
    "Firmware Development",
    "Medical Device Engineering (IEC 60601/62304)",
    "Smart Metering (DLMS/COSEM)",
    "Functional Safety (IEC 61508, ISO 13849, ISO 26262)",
    "EMI/EMC Consulting",
    "HIL/SIL Testing",
    "Industrial Automation & Vision",
    "AI & Software Solutions"
  ],
  "knowsAbout": [
    "Embedded Systems",
    "Electronics Design",
    "Medical Devices",
    "IEC 60601",
    "IEC 62304",
    "IEC 61508",
    "ISO 13849",
    "ISO 26262",
    "DLMS/COSEM",
    "Smart Metering",
    "EMI/EMC",
    "HIL/SIL",
    "Off-Highway Equipment",
    "Industrial Automation"
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${baseUrl}/#localbusiness`,
  "name": companyLegalName,
  "image": `${baseUrl}/logo.png`,
  "url": baseUrl,
  "telephone": "+1 (581) 578-3505",
  "email": "contact@horizontechmba.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "7139 Rue Henri-Julien",
    "addressLocality": "Lévis",
    "addressRegion": "QC",
    "postalCode": "G6Y 9X5",
    "addressCountry": "CA"
  },
  "priceRange": "$$$$",
  "openingHours": "Mo-Fr 09:00-17:00"
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": companyLegalName,
  "url": baseUrl,
  "serviceType": "Embedded Systems & Electronics Engineering Consulting",
  "areaServed": [
    { "@type": "Country", "name": "Canada" },
    { "@type": "Country", "name": "United States" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Engineering Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Embedded Systems & Electronics Design",
          "description": "PCB design, microcontrollers, FPGA, firmware and bootloaders for reliable embedded products"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Medical Device Engineering",
          "description": "Design and compliance support for medical devices under IEC 60601 and IEC 62304"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Smart Energy Metering",
          "description": "Smart metering solutions with DLMS/COSEM, energy monitoring and system integration"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Functional Safety",
          "description": "Safety-critical engineering under IEC 61508, ISO 13849 and ISO 26262"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "EMI/EMC Consulting",
          "description": "EMI/EMC compliance guidance and design recommendations"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "HIL/SIL & Matlab/Simulink",
          "description": "Test strategy, model-based development, and validation"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI & Software Solutions",
          "description": "Machine learning, computer vision and custom software for industrial applications"
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={companyLegalName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    
    <!-- Geo Tags for Local SEO -->
    <meta name="geo.region" content="CA-QC" />
    <meta name="geo.placename" content="Lévis, Quebec" />
    <meta name="geo.position" content="46.7387;-71.2480" />
    <meta name="ICBM" content="46.7387, -71.2480" />
    
    <!-- Language & Locale -->
    <meta http-equiv="content-language" content={lang} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />
    
    <!-- Hreflang tags for International SEO -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en-CA" href={enUrl} />
    <link rel="alternate" hreflang="fr-CA" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={`${baseUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${companyLegalName} - Engineering Consulting`} />
    <meta property="og:site_name" content={companyLegalName} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_CA' : 'fr_CA'} />
    
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={`${baseUrl}${ogImage}`} />
    <meta name="twitter:image:alt" content={`${companyLegalName} - Engineering Consulting`} />
    
    <!-- Additional SEO Meta Tags -->
    <meta name="theme-color" content="#009999" />
    <meta name="msapplication-TileColor" content="#009999" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- reCAPTCHA v3 Script -->
    <script src="https://www.google.com/recaptcha/api.js?render=6Lep81ssAAAAAGD9zNfk0QhZuxA_KpRTvoXkBZVn" async defer></script>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={jsonStringify(organizationSchema)} />
    <script type="application/ld+json" set:html={jsonStringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={jsonStringify(professionalServiceSchema)} />
    
    <!-- Preload critical resources -->
    <link rel="preload" as="image" href="/logo.png" />
    
    <!-- Google Analytics 4 & Google Tag Manager - Will be loaded after cookie consent -->
    <script is:inline set:html={`
      // GA4 & GTM Configuration - HORIZONTECH MBA
      window.GA4_ID = 'G-6RR6F0GWKH';
      window.GTM_ID = 'GTM-MB2PFGKF';
      // Contact API URL exposed for client-side form submission
      window.CONTACT_API_URL = '${contactApiUrl}';
      
      // Function to load GTM (called after consent)
      window.loadGTM = function() {
        if (window.gtmLoaded) return;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',window.GTM_ID);
        window.gtmLoaded = true;
      };
      
      // DataLayer for tracking
      window.dataLayer = window.dataLayer || [];
      
      // Track page view
      window.dataLayer.push({
        'event': 'page_view',
        'page_title': document.title,
        'page_location': window.location.href,
        'page_path': window.location.pathname,
        'language': document.documentElement.lang
      });
    `}></script>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MB2PFGKF"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main class="pt-24">
      <slot />
    </main>
    <Footer />
    <AiAdvisor />
    <CookieConsent />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  main {
    flex: 1;
  }
</style>
