---
// Root URL redirects to the language-prefixed home page.
// Canonical content lives at /en/ and /fr/ — avoids duplicate content.
const baseUrl = 'https://www.horizontechmba.com';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HORIZONTECH MBA Inc. — Embedded Systems Engineering</title>
    <link rel="canonical" href={`${baseUrl}/en/`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en/`} />
    <link rel="alternate" hreflang="fr" href={`${baseUrl}/fr/`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}/en/`} />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <script is:inline>
      var target = (navigator.language || '').toLowerCase().indexOf('fr') === 0 ? '/fr/' : '/en/';
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Redirecting… <a href="/en/">English</a> · <a href="/fr/">Français</a></p>
  </body>
</html>
